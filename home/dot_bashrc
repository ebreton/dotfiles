# shellcheck source-path=SCRIPTDIR
case $- in
    *i*) ;;
    *) return ;;
esac

if [ -r "$HOME/.config/shell/environment.sh" ]; then
    # shellcheck source=dot_config/shell/environment.sh
    . "$HOME/.config/shell/environment.sh"
fi
if [ -r "$HOME/.config/shell/interactive.sh" ]; then
    # shellcheck source=dot_config/shell/interactive.sh
    . "$HOME/.config/shell/interactive.sh"
fi

HISTCONTROL=ignoreboth
shopt -s histappend

if command -v pyenv >/dev/null 2>&1 && pyenv_setup="$(pyenv init - bash)"; then
    eval "$pyenv_setup"
fi
unset pyenv_setup
if command -v starship >/dev/null 2>&1 && starship_setup="$(starship init bash)"; then
    eval "$starship_setup"
fi
unset starship_setup
